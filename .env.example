# PostgreSQL local. Substitua usuário, senha e porta conforme sua instalação.
# Codifique caracteres especiais da senha para uso em URL.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/pharmix?schema=public"

# No Neon, use a conexão fornecida pelo painel com SSL:
# DATABASE_URL="postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require"

# Credenciais de observabilidade, se configurada. Nunca use valores reais aqui.
OBSERVE_APP_KEY=""
OBSERVE_APP_SECRET=""

PORT=3000

# Necessária apenas para npm run data:fetch (atualização da base externa).
# Consultar os dados importados pelo aplicativo não exige esta chave.
# Configure o valor real somente no .env local ou nos segredos da hospedagem.
DETECTA_API_KEY=""
